/* index.wxss */
.year-transition{position:fixed;inset:0;z-index:100;background:#172b3dcc;display:flex;align-items:center;justify-content:center;padding:36rpx;}
.transition-card{width:100%;padding:36rpx;background:#fffaf0;border-radius:24rpx;text-align:center;color:#263645;}
.transition-scene{padding:32rpx;margin-bottom:24rpx;background:linear-gradient(#c9dce4,#f0e0b8);border-radius:16rpx;font-size:44rpx;}
.transition-card progress{margin:28rpx 0;}.transition-note{font-size:24rpx;color:#667584;margin-bottom:20rpx;}
