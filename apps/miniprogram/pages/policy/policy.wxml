<view class="container">
  <view class="card">
    <view class="title">税率</view>
    <view style="font-size:24rpx;color:#54667a;">农民 {{taxFarmer}}%</view>
    <slider min="0" max="50" step="1" value="{{taxFarmer}}" data-key="taxFarmer" bindchange="onSlider" activeColor="#c0392b" />
    <view style="font-size:24rpx;color:#54667a;">工人 {{taxWorker}}%</view>
    <slider min="0" max="50" step="1" value="{{taxWorker}}" data-key="taxWorker" bindchange="onSlider" activeColor="#c0392b" />
    <view style="font-size:24rpx;color:#54667a;">商人 {{taxMerchant}}%</view>
    <slider min="0" max="50" step="1" value="{{taxMerchant}}" data-key="taxMerchant" bindchange="onSlider" activeColor="#c0392b" />
  </view>

  <view class="card">
    <view class="title">公务员配额</view>
    <view style="font-size:24rpx;color:#54667a;">税务 {{offTax}}</view>
    <slider min="0" max="20" step="1" value="{{offTax}}" data-key="offTax" bindchange="onSlider" />
    <view style="font-size:24rpx;color:#54667a;">治安 {{offSec}}</view>
    <slider min="0" max="20" step="1" value="{{offSec}}" data-key="offSec" bindchange="onSlider" />
    <view style="font-size:24rpx;color:#54667a;">民生 {{offWel}}</view>
    <slider min="0" max="20" step="1" value="{{offWel}}" data-key="offWel" bindchange="onSlider" />
    <view style="font-size:24rpx;color:#54667a;">军事 {{offMil}}</view>
    <slider min="0" max="20" step="1" value="{{offMil}}" data-key="offMil" bindchange="onSlider" />
    <view style="font-size:24rpx;color:#54667a;">教师 {{offTea}}</view>
    <slider min="0" max="20" step="1" value="{{offTea}}" data-key="offTea" bindchange="onSlider" />
  </view>

  <view class="card">
    <view class="title">军费</view>
    <view style="font-size:24rpx;color:#54667a;">国库占比 {{milRatio}}%</view>
    <slider min="0" max="50" step="1" value="{{milRatio}}" data-key="milRatio" bindchange="onSlider" activeColor="#c0392b" />
  </view>
</view>
